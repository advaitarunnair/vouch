# Copy to .env.local and fill in. Never commit real secrets.

# Anthropic (shop identification, screenshot vision, page scan, market query, chatbot)
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 when empty
ANTHROPIC_MODEL=

# Channel3 product search (price check and safer alternatives)
CHANNEL3_API_KEY=

# PayPal (sandbox only: the code refuses any other value)
PAYPAL_ENV=sandbox

# Per-shop sandbox REST app credentials (one sandbox business account per fictional shop).
# The checkout button uses the checked shop's own client ID (client IDs are public), so
# payments go to that shop; secrets stay on the server.
SHOP_AURORA_CLIENT_ID=
SHOP_AURORA_CLIENT_SECRET=
SHOP_GLOWBOX_CLIENT_ID=
SHOP_GLOWBOX_CLIENT_SECRET=
SHOP_FLASHDEAL_CLIENT_ID=
SHOP_FLASHDEAL_CLIENT_SECRET=

# Public base URL of this app, no trailing slash (own-page detection, PayPal return URLs)
APP_URL=http://localhost:3000

# SQLite file (optional; default data/vouch.db)
# DATABASE_PATH=
