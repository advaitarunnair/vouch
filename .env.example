# Copy to .env.local and fill in. Never commit real secrets.

# Anthropic (LLM + vision)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Channel3 product/price search
CHANNEL3_API_KEY=

# PayPal (sandbox only)
PAYPAL_ENV=sandbox
# Public client id used by the PayPal JavaScript SDK checkout button
PAYPAL_CLIENT_ID_PUBLIC=

# Per-shop sandbox REST app credentials (one sandbox business account per fictional shop)
SHOP_AURORA_CLIENT_ID=
SHOP_AURORA_CLIENT_SECRET=
SHOP_GLOWBOX_CLIENT_ID=
SHOP_GLOWBOX_CLIENT_SECRET=
SHOP_FLASHDEAL_CLIENT_ID=
SHOP_FLASHDEAL_CLIENT_SECRET=

# Public base URL of this app (used for PayPal return/cancel URLs). Local default shown.
APP_URL=http://localhost:3000
